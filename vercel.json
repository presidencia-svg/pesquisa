{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/retencao",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notificar-resultados",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/convite-pesquisa",
      "schedule": "*/5 11-17 13 9 *"
    },
    {
      "path": "/api/cron/convite-pesquisa/preflight",
      "schedule": "5 * * * *"
    }
  ]
}
