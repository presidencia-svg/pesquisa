# ==========================================================================
# Pesquisa Sergipe 2026 — variaveis de ambiente
# Copie pra .env.local e preenche os valores reais.
# Nomes alinhados com o projeto Melhores do Ano pra reuso direto.
# ==========================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://__projeto__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- HMAC do projeto (gerar com `openssl rand -hex 32`) ---
# IMPORTANTE: depois que cdl_base for importada, NUNCA mude CPF_HASH_SECRET.
CPF_HASH_SECRET=
TOKEN_VOTO_SECRET=
JWT_SECRET=

# --- Modo de desenvolvimento ---
# DEV_MODE=true ativa stubs locais (SPC e WhatsApp viram no-ops).
# Em producao (Vercel), remova ou deixe DEV_MODE=false.
DEV_MODE=true

# --- SPC Brasil (REST) ---
# Mesmas envs do Melhores do Ano — pode reaproveitar credenciais.
SPC_AMBIENTE=producao               # ou "homologacao" pra testar contra treinamento
SPC_USER=
SPC_PASSWORD=
SPC_CODIGO_PRODUTO=11
# URLs default ja inclusas em lib/env.ts; sobrescreva so se necessario:
# SPC_API_URL=https://api.spcbrasil.com.br/spcconsulta/recurso/consulta/padrao
# SPC_API_URL_HOMOLOG=https://treinamento.spcbrasil.com.br/spcconsulta/recurso/consulta/padrao
# SPC_MOCK=true                     # forca mock mesmo sem DEV_MODE

# --- Meta WhatsApp Cloud API ---
# Mesmas envs do Melhores do Ano. PHONE_IDS aceita CSV pra round-robin
# entre multiplos numeros.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_IDS=
META_API_VERSION=v21.0
# Template OTP (categoria AUTHENTICATION) aprovado no Meta Business Manager
# pra esta pesquisa. Pode reusar o do Melhores do Ano se ja' aprovado.
META_TEMPLATE_OTP=otp_pesquisa_sergipe
META_TEMPLATE_OTP_LANG=pt_BR

# --- Cloudflare Turnstile (anti-bot) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin ---
# Senha de acesso ao painel /admin. Em producao use senha forte (>= 16 chars).
ADMIN_PASSWORD=

# 2FA TOTP (Google Authenticator / Authy / 1Password). Opcional — se
# preenchido, o login pede senha + codigo de 6 digitos. Gerar via:
#   npm run totp:setup
# (imprime segredo em base32 + URL otpauth pra escanear como QR).
ADMIN_TOTP_SECRET=

# --- Import da base CDL (script `npm run import:cdl`) ---
# Credenciais do projeto Melhores do Ano pra leitura da tabela `votantes`.
# So preencher quando for rodar o import; deixe vazio em producao.
MELHORES_SUPABASE_URL=
MELHORES_SUPABASE_SERVICE_ROLE_KEY=
