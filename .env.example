# ==========================================================================
# Pesquisa Sergipe 2026 — variaveis de ambiente
# Copie pra .env.local e preenche os valores reais.
# ==========================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://__projeto__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Token de voto (HMAC) ---
# Gera com: openssl rand -hex 32
TOKEN_VOTO_SECRET=

# --- CPF hash (HMAC) ---
# Gera com: openssl rand -hex 32  (DIFERENTE do TOKEN_VOTO_SECRET)
CPF_HASH_SECRET=

# --- SPC Brasil ---
SPC_API_URL=
SPC_API_USER=
SPC_API_PASSWORD=

# --- WhatsApp Cloud API (Meta) ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_TEMPLATE_OTP=otp_pesquisa_sergipe

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Admin ---
# Login admin protegido (estilo do Melhores do Ano)
ADMIN_PASSWORD=
JWT_SECRET=
